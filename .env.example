# NSMISP Environment Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL="http://localhost:5173"
VITE_APP_NAME="NSMISP"

# PostgreSQL Connection
DATABASE_URL="postgresql://nsmisp:nsmisp123@localhost:5432/nsmisp?schema=public"

# Authentication & Security
JWT_SECRET="replace-with-secure-256-bit-access-secret"
JWT_REFRESH_SECRET="replace-with-secure-256-bit-refresh-secret"
COOKIE_SECURE="false" # Set to "true" in production under HTTPS

# Initial Super Admin Seed Credentials (used by scripts/seed-admin.mjs)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@nsmisp.net"
ADMIN_PASSWORD="StrongSuperAdminPassword2026!"

# MikroTik Network Default Credentials (Private Management)
MIKROTIK_DEFAULT_HOST="192.168.88.1"
MIKROTIK_DEFAULT_PORT=8728
MIKROTIK_DEFAULT_USER="admin"
MIKROTIK_DEFAULT_PASS="password"

# Redis & Background Processing
REDIS_URL="redis://localhost:6379"

# Notification Services
TELEGRAM_BOT_TOKEN="your_bot_token"
TELEGRAM_CHAT_ID="your_channel_or_chat_id"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@example.com"
SMTP_PASS="secret"

# Payment Gateways
BAKONG_MERCHANT_ID="merchant@bakong"
BAKONG_API_URL="https://api-bakong.nbc.org.kh/v1"
